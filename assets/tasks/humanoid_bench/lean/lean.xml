<mujocoinclude>
    <asset>
        <material name="wooden_cover" texuniform="false" texture="wooden_cover"/>
        <texture type="2d" name="wooden_cover" file="../assets/kitchen-wood.png"/>

        <material name="dark_wooden_cover" texuniform="false" texture="dark_wooden_cover"/>
        <texture type="2d" name="dark_wooden_cover" file="../assets/dark-wood.png"/>

        <material name="plywood_cover" texuniform="false" texture="plywood_cover"/>
        <texture type="2d" name="plywood_cover" file="../assets/plywood-4k.png"/>
    </asset>
    <worldbody>
        <body name="table" pos="1.1 0 0.20">
            <geom name="table_top" type="box" pos="0 0 0.4" size="0.7 1 0.05" class="visual" material="wooden_cover"/>
            <!-- Softer table contact: timeconst 20ms → 40ms (mujoco.readthedocs.io
                 /modeling#solref), peak impedance 0.95→0.85. Halves the contact-
                 impulse spike when the hand plants, giving MJPC ~2-3 control
                 cycles (at 15ms each) to ramp Brace Force before the back-torque
                 destabilises the torso. priority=1 ensures these params win over
                 hand-side defaults in MuJoCo's contact-combination rule. -->
            <geom name="table_top_collision" type="box" pos="0 0 0.4" size="0.7 1 0.05" class="collision"
                  priority="1" solref="0.04 1" solimp="0.85 0.95 0.001 0.5 2"/>
            <geom name="table_leg_1" type="box" pos="0.4 0.85 -0.05" size="0.05 0.05 0.4" class="visual"
                  material="dark_wooden_cover"/>
            <geom name="table_leg_2" type="box" pos="0.4 -0.85 -0.05" size="0.05 0.05 0.4" class="visual"
                  material="dark_wooden_cover"/>
            <geom name="table_leg_3" type="box" pos="-0.4 0.85 -0.05" size="0.05 0.05 0.4" class="visual"
                  material="dark_wooden_cover"/>
            <geom name="table_leg_4" type="box" pos="-0.4 -0.85 -0.05" size="0.05 0.05 0.4" class="visual"
                  material="dark_wooden_cover"/>
            <geom name="table_leg_1_collision" type="box" pos="0.4 0.85 -0.05" size="0.05 0.05 0.4" class="collision"/>
            <geom name="table_leg_2_collision" type="box" pos="0.4 -0.85 -0.05" size="0.05 0.05 0.4" class="collision"/>
            <geom name="table_leg_3_collision" type="box" pos="-0.4 0.85 -0.05" size="0.05 0.05 0.4" class="collision"/>
            <geom name="table_leg_4_collision" type="box" pos="-0.4 -0.85 -0.05" size="0.05 0.05 0.4"
                  class="collision"/>
        </body>
        <!-- Object placed farther on table to require leaning -->
        <!-- Detachable object - child of world initially -->
        <body name="object_anchor" pos="1.5 0 0.73">
            <joint name="object_anchor_joint" type="free" limited="false"/>
            
            <body name="object" pos="0 0 0">
                <inertial pos="0 0 0" mass="0.3" diaginertia="0.001 0.001 0.001"/>
                <!-- Add contype/conaffinity to control collision -->
                <geom name="object" type="box" size="0.02 0.02 0.08" rgba="0.67 0.73 0.78 1" 
                    class="visual" contype="1" conaffinity="1"/>
                <geom name="object_collision" type="box" size="0.02 0.02 0.08" 
                    class="collision" contype="1" conaffinity="1"/>
            </body>
        </body>
        <!-- Target position visualization -->
        <body name="target" mocap="true" pos="1.5 0.0 0.73">
            <geom type="sphere" size="0.03" contype="0" conaffinity="0" rgba="0 1 0 .5"/>
        </body>
    </worldbody>
</mujocoinclude>